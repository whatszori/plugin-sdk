{
  "name": "@whatszori/plugin-sdk",
  "version": "0.1.0",
  "description": "Types, a JSX runtime and a CLI for building WhatsZori plugins",
  "license": "MIT",
  "author": "Obzori",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatszori/plugin-sdk.git"
  },
  "homepage": "https://github.com/whatszori/plugin-sdk#readme",
  "keywords": [
    "whatszori",
    "plugin",
    "sdk",
    "whatsapp"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "wz-plugin": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./manifest.schema.json": "./schema/manifest.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "templates",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@types/react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
