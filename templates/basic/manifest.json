{
  "$schema": "./node_modules/@whatszori/plugin-sdk/schema/manifest.schema.json",
  "id": "{{id}}",
  "name": "{{name}}",
  "version": "0.1.0",
  "description": "A WhatsZori plugin",
  "author": "{{author}}",
  "apiVersion": 2,
  "permissions": ["composer", "messages"],
  "settings": [
    {
      "key": "greeting",
      "type": "text",
      "label": "Greeting",
      "description": "What the 👋 button puts into the message box.",
      "default": "Hi!"
    }
  ]
}
